# Telegram MTProto credentials — get yours at https://my.telegram.org
# (Apps → create application).
VITE_TG_API_ID=
VITE_TG_API_HASH=

# OpenSubtitles credentials (optional). Without these, the app only uses
# subtitle files shared in the same Telegram chat as the video. Register at
# https://www.opensubtitles.com to get the API key + account.
VITE_OPENSUBTITLES_API_KEY=
VITE_OPENSUBTITLES_USERNAME=
VITE_OPENSUBTITLES_PASSWORD=
